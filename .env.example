# ==============================================================================
# RAG Project Environment Configuration Template
# Copy this file to `.env` and fill in your keys. Do not commit `.env` to git!
# ==============================================================================

# --- Supabase (authentication + cloud storage) --------------------------------
# Set both to enable multi-user auth AND Supabase Storage (cloud sync for
# documents, FAISS indexes, and user config).  Leave blank for single-user mode.
# No service-role key is needed — the backend uses the user's JWT with RLS.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# --- Provider selection -------------------------------------------------------
# LLM_PROVIDER:       ollama | openai | anthropic | gemini | grok | cohere
# EMBEDDING_PROVIDER: ollama | openai | gemini | cohere
#
# The two are selected independently because Anthropic and xAI/Grok publish no
# embeddings API. A RAG pipeline always needs embeddings, so those two are
# chat-only and must be paired with another embedding provider, e.g.:
#   LLM_PROVIDER=anthropic + EMBEDDING_PROVIDER=openai
LLM_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama

# --- Model overrides (optional) -----------------------------------------------
# Leave unset to take each provider's default:
#   ollama    llama3.2:1b            / nomic-embed-text
#   openai    gpt-4o-mini            / text-embedding-3-small
#   anthropic claude-opus-5          / (no embeddings)
#   gemini    gemini-2.5-flash       / text-embedding-004
#   grok      grok-4                 / (no embeddings)
#   cohere    command-a-03-2025      / embed-english-v3.0
# Verify the exact model id is enabled for your account before relying on it.
LLM_MODEL=
EMBEDDING_MODEL=

# --- Credentials --------------------------------------------------------------
# Only the selected providers' keys are required. Ollama is local and needs none.
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
XAI_API_KEY=your_xai_api_key_here
COHERE_API_KEY=your_cohere_api_key_here

# --- Query Routing Configuration ----------------------------------------------
# - 'semantic': In-memory embeddings classification (zero LLM tokens, <10ms)
# - 'llm':      Structured reasoning via the chat model. Needs a capable model —
#               small local models return invalid route names.
ROUTING_METHOD=semantic

# --- Reranking Provider Configuration -----------------------------------------
# - 'flashrank': Fast, free local cross-encoder model (default)
# - 'cohere':    Cloud Cohere Rerank API (requires COHERE_API_KEY)
RERANKER_PROVIDER=flashrank

# --- LangSmith Tracing & Observability (Optional) -----------------------------
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT="rag-agent-playground"

# --- Evaluation (Optional) ----------------------------------------------------
# Scores are computed in-process with the models configured above, so the judge
# is whatever this workspace already uses. Small local models are not reliable
# judges — the dashboard warns when one is in use.
#
# Concurrent judge calls. Low by default: the judge shares a rate limit with
# live chat traffic, and a local Ollama serialises requests anyway.
EVAL_MAX_WORKERS=4
# Per-judge-call ceiling in seconds. RAGAS defaults to 180, which a local model
# on CPU routinely exceeds — the call is slow, not wedged, and timing it out
# silently drops that row's score.
EVAL_TIMEOUT_SECONDS=900
# Cap on test set size. Each question costs a full RAG query plus one judge call
# per metric, so this is the ceiling on what a single run can spend.
MAX_TESTSET_SIZE=50
